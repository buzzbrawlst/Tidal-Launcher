<Window x:Class="TidalLauncher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Tidal Launcher" Width="1200" Height="750" MinWidth="900" MinHeight="600" WindowStartupLocation="CenterScreen" Background="#008BD1">
    <Grid>
        <Grid>
            <Grid.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#20CFFF" Offset="0"/><GradientStop Color="#008BD1" Offset="0.5"/><GradientStop Color="#004E86" Offset="1"/>
                </LinearGradientBrush>
            </Grid.Background>
        </Grid>
        <Rectangle>
            <Rectangle.Fill><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#10000000" Offset="0"/><GradientStop Color="#50000000" Offset="1"/></LinearGradientBrush></Rectangle.Fill>
        </Rectangle>
        <Grid Margin="25">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Border Grid.Row="0" Background="#30000000" BorderBrush="#55FFFFFF" BorderThickness="1" CornerRadius="18" Padding="18" Margin="0,0,0,15">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center"><TextBlock Text="TIDAL" Foreground="White" FontSize="27" FontWeight="Bold"/><TextBlock Text="OG CHAPTER 2" Foreground="#8EE9FF" FontSize="12" FontWeight="Bold" Margin="1,2,0,0"/></StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="HomeButton" Content="HOME" Width="90" Height="38" Margin="0,0,8,0" Foreground="White" Background="#25FFFFFF" BorderBrush="#55FFFFFF" BorderThickness="1" Click="HomeButton_Click"/>
                        <Button x:Name="NewsButton" Content="NEWS" Width="90" Height="38" Margin="0,0,8,0" Foreground="White" Background="#25FFFFFF" BorderBrush="#55FFFFFF" BorderThickness="1" Click="NewsButton_Click"/>
                        <Button x:Name="DiscordButton" Content="DISCORD" Width="100" Height="38" Margin="0,0,8,0" Foreground="White" Background="#25FFFFFF" BorderBrush="#55FFFFFF" BorderThickness="1" Click="DiscordButton_Click"/>
                        <Button x:Name="AccountButton" Content="LOGIN" Width="110" Height="38" Foreground="White" Background="#35FFFFFF" BorderBrush="#80FFFFFF" BorderThickness="1" Click="AccountButton_Click"/>
                    </StackPanel>
                </Grid>
            </Border>
            <Border Grid.Row="1" Background="#25000000" BorderBrush="#45FFFFFF" BorderThickness="1" CornerRadius="22" ClipToBounds="True">
                <Grid>
                    <Grid x:Name="HomePanel" Visibility="Visible">
                        <Grid Margin="25"><Border CornerRadius="20" BorderBrush="#70FFFFFF" BorderThickness="1" ClipToBounds="True"><Grid>
                            <Image x:Name="HeroImage" Stretch="UniformToFill" Source="https://assetsio.gnwcdn.com/fortnite-chapter-2-season-3-a.jpg?width=1600&amp;height=900&amp;fit=crop&amp;quality=100&amp;format=png&amp;enable=upscale&amp;auto=png"/>
                            <Rectangle><Rectangle.Fill><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#00000000" Offset="0"/><GradientStop Color="#DD000000" Offset="1"/></LinearGradientBrush></Rectangle.Fill></Rectangle>
                            <StackPanel VerticalAlignment="Bottom" Margin="30"><TextBlock Text="TIDAL PROJECT" Foreground="#8EE9FF" FontSize="12" FontWeight="Bold"/><TextBlock Text="OG Chapter 2" Foreground="White" FontSize="42" FontWeight="Bold" Margin="0,4,0,0"/><TextBlock Text="Experience the classic Chapter 2 era with Tidal." Foreground="#DDFFFFFF" FontSize="14" TextWrapping="Wrap" MaxWidth="600" Margin="0,8,0,18"/><Button x:Name="LaunchButton" Content="LAUNCH TIDAL" Width="160" Height="45" HorizontalAlignment="Left" Foreground="White" Background="#35FFFFFF" BorderBrush="#80FFFFFF" BorderThickness="1" Click="LaunchButton_Click"/></StackPanel>
                        </Grid></Border></Grid>
                    </Grid>
                    <Grid x:Name="NewsPanel" Visibility="Collapsed"><wv2:WebView2 x:Name="NewsBrowser" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/></Grid>
                </Grid>
            </Border>
            <Grid Grid.Row="2" Margin="5,12,5,0"><TextBlock Text="Tidal Project" Foreground="#99FFFFFF" FontSize="11" VerticalAlignment="Center"/><TextBlock Text="OG CHAPTER 2" Foreground="#77FFFFFF" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center"/></Grid>
        </Grid>
        <Grid x:Name="LoginOverlay" Visibility="Collapsed" Panel.ZIndex="50" Background="#66000000">
            <Border Width="430" Padding="35" CornerRadius="24" Background="#DD102A3A" BorderBrush="#70FFFFFF" BorderThickness="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="TIDAL" Foreground="White" FontSize="34" FontWeight="Bold" HorizontalAlignment="Center"/>
                    <TextBlock Text="Sign in to continue" Foreground="#BBFFFFFF" FontSize="14" HorizontalAlignment="Center" Margin="0,5,0,25"/>
                    <Button x:Name="LoginButton" Content="CONTINUE WITH DISCORD" Width="280" Height="52" HorizontalAlignment="Center" Foreground="White" Background="#5865F2" BorderThickness="0" FontWeight="Bold" Click="LoginButton_Click"/>
                    <ProgressBar x:Name="LoginProgress" Width="280" Height="5" Margin="0,15,0,0" IsIndeterminate="True" Visibility="Collapsed"/>
                    <TextBlock x:Name="LoginStatus" Text="" Foreground="#CCFFFFFF" FontSize="12" TextWrapping="Wrap" HorizontalAlignment="Center" TextAlignment="Center" Margin="0,14,0,0"/>
                    <Button Content="CLOSE" Width="100" Height="34" HorizontalAlignment="Center" Margin="0,18,0,0" Foreground="White" Background="#20FFFFFF" BorderBrush="#50FFFFFF" Click="CloseLogin_Click"/>
                </StackPanel>
            </Border>
            <wv2:WebView2 x:Name="OAuthBrowser" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center" Width="900" Height="600"/>
        </Grid>
    </Grid>
</Window>