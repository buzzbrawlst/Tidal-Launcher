<Window x:Class="TidalLauncher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Tidal Launcher"
        Width="1200"
        Height="750"
        MinWidth="900"
        MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="#008BD1">

    <Grid>

        <!-- WATER BACKGROUND -->

        <Grid>

            <Grid.Background>

                <LinearGradientBrush
                    StartPoint="0,0"
                    EndPoint="0,1">

                    <GradientStop
                        Color="#20CFFF"
                        Offset="0"/>

                    <GradientStop
                        Color="#008BD1"
                        Offset="0.5"/>

                    <GradientStop
                        Color="#004E86"
                        Offset="1"/>

                </LinearGradientBrush>

            </Grid.Background>

        </Grid>


        <!-- DARK OVERLAY -->

        <Rectangle>

            <Rectangle.Fill>

                <LinearGradientBrush
                    StartPoint="0,0"
                    EndPoint="0,1">

                    <GradientStop
                        Color="#10000000"
                        Offset="0"/>

                    <GradientStop
                        Color="#50000000"
                        Offset="1"/>

                </LinearGradientBrush>

            </Rectangle.Fill>

        </Rectangle>


        <!-- EVERYTHING -->

        <Grid Margin="25">

            <Grid.RowDefinitions>

                <RowDefinition Height="Auto"/>

                <RowDefinition Height="*"/>

                <RowDefinition Height="Auto"/>

            </Grid.RowDefinitions>


            <!-- NAVBAR -->

            <Border
                Grid.Row="0"
                Background="#30000000"
                BorderBrush="#55FFFFFF"
                BorderThickness="1"
                CornerRadius="18"
                Padding="18"
                Margin="0,0,0,15">

                <Grid>

                    <Grid.ColumnDefinitions>

                        <ColumnDefinition Width="*"/>

                        <ColumnDefinition Width="Auto"/>

                    </Grid.ColumnDefinitions>


                    <!-- LOGO -->

                    <StackPanel
                        VerticalAlignment="Center">

                        <TextBlock
                            Text="TIDAL"
                            Foreground="White"
                            FontSize="27"
                            FontWeight="Bold"/>

                        <TextBlock
                            Text="OG CHAPTER 2"
                            Foreground="#8EE9FF"
                            FontSize="12"
                            FontWeight="Bold"
                            Margin="1,2,0,0"/>

                    </StackPanel>


                    <!-- NAVIGATION -->

                    <StackPanel
                        Grid.Column="1"
                        Orientation="Horizontal"
                        VerticalAlignment="Center">

                        <Button
                            x:Name="HomeButton"
                            Content="HOME"
                            Width="90"
                            Height="38"
                            Margin="0,0,8,0"
                            Foreground="White"
                            Background="#25FFFFFF"
                            BorderBrush="#55FFFFFF"
                            BorderThickness="1"
                            Click="HomeButton_Click"/>

                        <Button
                            x:Name="NewsButton"
                            Content="NEWS"
                            Width="90"
                            Height="38"
                            Margin="0,0,8,0"
                            Foreground="White"
                            Background="#25FFFFFF"
                            BorderBrush="#55FFFFFF"
                            BorderThickness="1"
                            Click="NewsButton_Click"/>

                        <Button
                            x:Name="DiscordButton"
                            Content="DISCORD"
                            Width="100"
                            Height="38"
                            Foreground="White"
                            Background="#25FFFFFF"
                            BorderBrush="#55FFFFFF"
                            BorderThickness="1"
                            Click="DiscordButton_Click"/>

                    </StackPanel>

                </Grid>

            </Border>


            <!-- MAIN CONTENT -->

            <Border
                Grid.Row="1"
                Background="#25000000"
                BorderBrush="#45FFFFFF"
                BorderThickness="1"
                CornerRadius="22"
                ClipToBounds="True">

                <Grid>


                    <!-- HOME -->

                    <Grid
                        x:Name="HomePanel"
                        Visibility="Visible">

                        <Grid Margin="25">

                            <Border
                                CornerRadius="20"
                                BorderBrush="#70FFFFFF"
                                BorderThickness="1"
                                ClipToBounds="True">

                                <Grid>

                                    <!-- HERO IMAGE -->

                                    <Image
                                        x:Name="HeroImage"
                                        Stretch="UniformToFill"
                                        Source="https://assetsio.gnwcdn.com/fortnite-chapter-2-season-3-a.jpg?width=1600&amp;height=900&amp;fit=crop&amp;quality=100&amp;format=png&amp;enable=upscale&amp;auto=png"/>


                                    <!-- DARK GRADIENT -->

                                    <Rectangle>

                                        <Rectangle.Fill>

                                            <LinearGradientBrush
                                                StartPoint="0,0"
                                                EndPoint="0,1">

                                                <GradientStop
                                                    Color="#00000000"
                                                    Offset="0"/>

                                                <GradientStop
                                                    Color="#DD000000"
                                                    Offset="1"/>

                                            </LinearGradientBrush>

                                        </Rectangle.Fill>

                                    </Rectangle>


                                    <!-- HERO CONTENT -->

                                    <StackPanel
                                        VerticalAlignment="Bottom"
                                        Margin="30">

                                        <TextBlock
                                            Text="TIDAL PROJECT"
                                            Foreground="#8EE9FF"
                                            FontSize="12"
                                            FontWeight="Bold"/>

                                        <TextBlock
                                            Text="OG Chapter 2"
                                            Foreground="White"
                                            FontSize="42"
                                            FontWeight="Bold"
                                            Margin="0,4,0,0"/>

                                        <TextBlock
                                            Text="Experience the classic Chapter 2 era with Tidal."
                                            Foreground="#DDFFFFFF"
                                            FontSize="14"
                                            TextWrapping="Wrap"
                                            MaxWidth="600"
                                            Margin="0,8,0,18"/>

                                        <Button
                                            x:Name="LaunchButton"
                                            Content="LAUNCH TIDAL"
                                            Width="160"
                                            Height="45"
                                            HorizontalAlignment="Left"
                                            Foreground="White"
                                            Background="#35FFFFFF"
                                            BorderBrush="#80FFFFFF"
                                            BorderThickness="1"
                                            Click="LaunchButton_Click"/>

                                    </StackPanel>

                                </Grid>

                            </Border>

                        </Grid>

                    </Grid>


                    <!-- NEWS -->

                    <Grid
                        x:Name="NewsPanel"
                        Visibility="Collapsed">

                        <wv2:WebView2
                            x:Name="NewsBrowser"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch"/>

                    </Grid>

                </Grid>

            </Border>


            <!-- FOOTER -->

            <Grid
                Grid.Row="2"
                Margin="5,12,5,0">

                <TextBlock
                    Text="Tidal Project"
                    Foreground="#99FFFFFF"
                    FontSize="11"
                    VerticalAlignment="Center"/>

                <TextBlock
                    Text="OG CHAPTER 2"
                    Foreground="#77FFFFFF"
                    FontSize="11"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"/>

            </Grid>

        </Grid>

    </Grid>

</Window>